# astro-auto-import@0.5.1 (latest) declares a conservative peer range
# (astro ^5 || ^6) and has no release yet that lists astro 7 as a supported
# peer. The plugin works correctly at runtime under astro 7 (the full site
# builds and all MDX auto-imported shortcodes render), so we relax npm's strict
# peer check here. This mirrors the deploy path, which installs with yarn and
# only warns on peer mismatches. Remove this once astro-auto-import publishes a
# release that supports astro 7.
legacy-peer-deps=true
